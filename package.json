{
  "name": "google-mcp",
  "version": "0.1.0",
  "description": "MCP server for Google Calendar, designed for Barback upstream integration.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:contract": "bun test test/contract",
    "check": "bun --no-env-file run typecheck && bun --no-env-file run lint && bun --no-env-file test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "hono": "4.13.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.3.5",
    "typescript": "5.9.2"
  },
  "packageManager": "bun@1.4.0"
}
