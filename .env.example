# Port on which the MCP Streamable HTTP server listens inside the container.
GOOGLE_MCP_PORT=8090
# Optional bearer token required by the server; Barback can send it as an
# upstream credential. Omit it to disable authentication in local development.
GOOGLE_MCP_TOKEN=replace-with-mcp-token
# OAuth client credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=replace-with-client-id
GOOGLE_CLIENT_SECRET=replace-with-client-secret
# Long-lived user credential. Obtain it with ./scripts/google-auth.ts and keep
# it out of source control.
GOOGLE_REFRESH_TOKEN=replace-with-refresh-token
# Default calendar for tools that accept a calendarId argument.
GOOGLE_DEFAULT_CALENDAR_ID=primary
